{
  "version": 2,
  "name": "kamzo-admin",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@kamzo_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@kamzo_supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@kamzo_service_role_key"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
